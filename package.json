{
  "name": "therapist-booking",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --filter @app/server dev",
    "dev:web": "bun run --filter @app/web dev",
    "seed": "bun run --filter @app/server seed",
    "test": "bun test ./apps ./packages",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter @app/web build"
  }
}
